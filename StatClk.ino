// =====================================================
// OLED 1 WEB HANDLER
// =====================================================

void handleOLED1() {

  if (!server.hasArg("image")) {

    server.send(
      400,
      "text/plain",
      "Missing image"
    );

    return;
  }


  oled1Image =
    server.arg("image").toInt();


  if (oled1Image == 0) {

    oled1CurrentImage = 1;

    showOLED1Image(
      oled1CurrentImage
    );

  }

  else {

    showOLED1Image(
      oled1Image
    );
  }


  server.send(
    200,
    "text/plain",
    "OLED 1 updated"
  );
}


// =====================================================
// OLED 4 WEB HANDLER
// =====================================================

void handleOLED4() {

  if (!server.hasArg("image")) {

    server.send(
      400,
      "text/plain",
      "Missing image"
    );

    return;
  }


  oled4Image =
    server.arg("image").toInt();


  if (oled4Image == 0) {

    oled4CurrentImage = 1;

    showOLED4Image(
      oled4CurrentImage
    );

  }

  else {

    showOLED4Image(
      oled4Image
    );
  }


  server.send(
    200,
    "text/plain",
    "OLED 4 updated"
  );
}


// =====================================================
// LCD WEB HANDLER
// =====================================================

void handleLCD() {

  if (server.hasArg("line1")) {

    lcdLine1 =
      server.arg("line1");
  }


  if (server.hasArg("line2")) {

    lcdLine2 =
      server.arg("line2");
  }


  // Make absolutely sure the lines
  // don't exceed 16 characters.

  if (lcdLine1.length() > 16) {

    lcdLine1 =
      lcdLine1.substring(0, 16);
  }


  if (lcdLine2.length() > 16) {

    lcdLine2 =
      lcdLine2.substring(0, 16);
  }


  updateLCD();


  server.send(
    200,
    "text/plain",
    "LCD updated"
  );
}


// =====================================================
// TIME WEB HANDLER
// =====================================================

void handleTime() {

  if (
    !server.hasArg("hour") ||
    !server.hasArg("minute") ||
    !server.hasArg("second") ||
    !server.hasArg("day") ||
    !server.hasArg("month") ||
    !server.hasArg("year")
  ) {

    server.send(
      400,
      "text/plain",
      "Missing time data"
    );

    return;
  }


  currentHour =
    server.arg("hour").toInt();


  currentMinute =
    server.arg("minute").toInt();


  currentSecond =
    server.arg("second").toInt();


  currentDay =
    server.arg("day").toInt();


  currentMonth =
    server.arg("month").toInt();


  currentYear =
    server.arg("year").toInt();


  timeReceived = true;


  lastLocalSecond =
    millis();


  refreshOLED2();

  refreshOLED3();


  server.send(
    200,
    "text/plain",
    "Time synchronized"
  );
}


// =====================================================
// TEMPERATURE WEB HANDLER
// =====================================================

void handleTemperature() {

  if (!server.hasArg("value")) {

    server.send(
      400,
      "text/plain",
      "Missing temperature"
    );

    return;
  }


  temperature =
    server.arg("value").toFloat();


  temperatureReceived =
    true;


  lastTemperatureUpdate =
    millis();


  refreshOLED3();


  server.send(
    200,
    "text/plain",
    "Temperature updated"
  );
}


// =====================================================
// 404
// =====================================================

void handleNotFound() {

  server.send(
    404,
    "text/plain",
    "Not found"
  );
}


// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);


  Serial.println();

  Serial.println(
    "================================"
  );

  Serial.println(
    "ESP32 DISPLAY CONTROLLER"
  );

  Serial.println(
    "================================"
  );


  // ===================================================
  // LCD
  // ===================================================

  Wire.begin(18, 19);

  lcd.init();

  lcd.backlight();

  lcd.clear();

  lcd.setCursor(0, 0);

  lcd.print("Connecting WiFi");


  // ===================================================
  // OLED INITIALIZATION
  // ===================================================

  Serial.println(
    "Initializing OLEDs..."
  );


  oled1.initOLED();

  oled2.initOLED();

  oled3.initOLED();

  oled4.initOLED();


  Serial.println(
    "OLEDs initialized."
  );


  // ===================================================
  // INITIAL IMAGES
  // ===================================================

  oled1CurrentImage = 1;

  oled4CurrentImage = 1;


  showOLED1Image(
    oled1CurrentImage
  );


  showOLED4Image(
    oled4CurrentImage
  );


  // ===================================================
  // WIFI
  // ===================================================

  WiFi.mode(WIFI_STA);

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );


  Serial.print(
    "Connecting to Wi-Fi"
  );


  while (
    WiFi.status() != WL_CONNECTED
  ) {

    delay(500);

    Serial.print(".");
  }


  Serial.println();

  Serial.println(
    "Wi-Fi connected!"
  );


  Serial.print(
    "IP address: "
  );

  Serial.println(
    WiFi.localIP()
  );


  // ===================================================
  // LCD READY
  // ===================================================

  lcd.clear();

  lcd.setCursor(0, 0);

  lcd.print("WiFi Connected");


  lcd.setCursor(0, 1);

  lcd.print(
    WiFi.localIP().toString()
  );


  // ===================================================
  // WEB SERVER ROUTES
  // ===================================================

  server.on(
    "/",
    handleRoot
  );


  server.on(
    "/oled1",
    handleOLED1
  );


  server.on(
    "/oled4",
    handleOLED4
  );


  server.on(
    "/lcd",
    handleLCD
  );


  server.on(
    "/time",
    handleTime
  );


  server.on(
    "/temperature",
    handleTemperature
  );


  server.onNotFound(
    handleNotFound
  );


  server.begin();


  Serial.println(
    "Web server started!"
  );


  Serial.print(
    "Open: http://"
  );

  Serial.print(
    WiFi.localIP()
  );

  Serial.println(
    "/"
  );


  // ===================================================
  // START IMAGE ROTATION TIMER
  // ===================================================

  lastImageChange =
    millis();


  // ===================================================
  // INITIAL DISPLAY UPDATE
  // ===================================================

  refreshOLED2();

  refreshOLED3();

  updateLCD();
}


// =====================================================
// LOOP
// =====================================================

void loop() {

  // Handle browser requests

  server.handleClient();


  // Keep clock running

  advanceTime();


  // Rotate OLED images

  updateRotatingImages();


  // Update OLED clock displays every second

  static unsigned long lastDisplayUpdate = 0;


  if (
    millis() - lastDisplayUpdate >= 1000
  ) {

    lastDisplayUpdate =
      millis();


    if (timeReceived) {

      refreshOLED2();

      refreshOLED3();
    }
  }
}
