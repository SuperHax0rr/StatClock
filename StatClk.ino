// =====================================================
// IMAGE ROTATION
// =====================================================

void updateRotatingImages() {

  unsigned long now =
    millis();


  if (now - lastImageChange <
      IMAGE_INTERVAL) {

    return;
  }


  lastImageChange = now;


  // OLED 1

  if (oled1Image == 0) {

    oled1CurrentImage++;

    if (oled1CurrentImage > 3) {
      oled1CurrentImage = 1;
    }

    showOLED1Image(
      oled1CurrentImage
    );
  }


  // OLED 4

  if (oled4Image == 0) {

    oled4CurrentImage++;

    if (oled4CurrentImage > 3) {
      oled4CurrentImage = 1;
    }

    showOLED4Image(
      oled4CurrentImage
    );
  }
}


