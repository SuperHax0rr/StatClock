<script>


// =====================================================
// OLED 1
// =====================================================

function setOLED1() {

  let value =
    document.getElementById(
      "oled1"
    ).value;


  fetch(
    "/oled1?image=" + value
  );
}


// =====================================================
// OLED 4
// =====================================================

function setOLED4() {

  let value =
    document.getElementById(
      "oled4"
    ).value;


  fetch(
    "/oled4?image=" + value
  );
}


// =====================================================
// LCD
// =====================================================

function setLCD() {

  let line1 =
    document.getElementById(
      "lcd1"
    ).value;


  let line2 =
    document.getElementById(
      "lcd2"
    ).value;


  fetch(
    "/lcd?line1=" +
    encodeURIComponent(line1) +
    "&line2=" +
    encodeURIComponent(line2)
  );
}


// =====================================================
// TIME SYNC
// =====================================================

function syncTime() {

  let now =
    new Date();


  let data = {

    hour: now.getHours(),

    minute: now.getMinutes(),

    second: now.getSeconds(),

    day: now.getDate(),

    month: now.getMonth() + 1,

    year: now.getFullYear()
  };


  fetch(
    "/time?" +
    new URLSearchParams(data)
  );
}


// =====================================================
// UPDATE TIME AUTOMATICALLY
// =====================================================

function automaticTimeSync() {

  syncTime();

}


// Sync immediately

automaticTimeSync();


// Sync every 30 seconds

setInterval(
  automaticTimeSync,
  30000
);


// =====================================================
// UPDATE WEATHER
// =====================================================

async function updateWeather() {

  try {

    const response =
      await fetch(
        "https://api.open-meteo.com/v1/forecast?latitude=12.9716&longitude=77.5946&current=temperature_2m&timezone=Asia%2FKolkata"
      );


    const data =
      await response.json();


    const temp =
      data.current.temperature_2m;


    document.getElementById(
      "temperature"
    ).innerText =
      temp + " °C";


    // Send temperature to ESP32

    fetch(
      "/temperature?value=" +
      encodeURIComponent(temp)
    );

  }

  catch (error) {

    console.log(
      "Weather error:",
      error
    );

  }

}


// Get weather immediately

updateWeather();


// Refresh every 5 minutes

setInterval(
  updateWeather,
  300000
);


</script>


