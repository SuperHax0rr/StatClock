void refreshOLED2() {

  uint8_t buffer[1024];

  clearBuffer(buffer);


  char hourText[3];

  snprintf(
    hourText,
    sizeof(hourText),
    "%02d",
    currentHour
  );


  char dateText[11];

  snprintf(
    dateText,
    sizeof(dateText),
    "%02d/%02d/%04d",
    currentDay,
    currentMonth,
    currentYear
  );


  // Large hour

  int hourWidth = 2 * 6 * 6;

  int hourX =
    (128 - hourWidth) / 2;

  drawText(
    buffer,
    hourText,
    hourX,
    5,
    6
  );


  // Small date

  int dateWidth = 10 * 6 * 2;

  int dateX =
    (128 - dateWidth) / 2;

  drawText(
    buffer,
    dateText,
    dateX,
    50,
    2
  );


  // Display using same OLED protocol

  uint8_t pageBuffer[128];


  for (int page = 0; page < 8; page++) {

    for (int x = 0; x < 128; x++) {

      uint8_t value = 0;


      for (int bit = 0; bit < 8; bit++) {

        int y =
          page * 8 + bit;


        int byteIndex =
          y * 16 + x / 8;


        uint8_t sourceByte =
          buffer[byteIndex];


        uint8_t mask =
          0x80 >> (x & 7);


        if (sourceByte & mask) {

          value |=
            (1 << bit);
        }
      }


      pageBuffer[x] = value;
    }


    oled2.command(0xB0 + page);

    oled2.command(0x00);

    oled2.command(0x10);


    oled2.start();

    oled2.writeByte(
      (OLED_ADDRESS << 1) | 0
    );

    oled2.writeByte(0x40);


    for (int x = 0; x < 128; x++) {

      oled2.writeByte(
        pageBuffer[x]
      );
    }


    oled2.stop();
  }
}


