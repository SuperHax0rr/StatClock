// =====================================================
// TIME CALCULATION
// =====================================================

void advanceTime() {

  if (!timeReceived) {
    return;
  }


  unsigned long now = millis();


  while (now - lastLocalSecond >= 1000) {

    lastLocalSecond += 1000;

    currentSecond++;


    if (currentSecond >= 60) {

      currentSecond = 0;

      currentMinute++;


      if (currentMinute >= 60) {

        currentMinute = 0;

        currentHour++;


        if (currentHour >= 24) {

          currentHour = 0;

          currentDay++;


          // Simple month lengths
          int daysInMonth = 31;


          if (currentMonth == 4 ||
              currentMonth == 6 ||
              currentMonth == 9 ||
              currentMonth == 11) {

            daysInMonth = 30;
          }


          if (currentMonth == 2) {

            daysInMonth = 28;

            // Leap year
            if ((currentYear % 4 == 0 &&
                 currentYear % 100 != 0) ||
                (currentYear % 400 == 0)) {

              daysInMonth = 29;
            }
          }


          if (currentDay > daysInMonth) {

            currentDay = 1;

            currentMonth++;


            if (currentMonth > 12) {

              currentMonth = 1;

              currentYear++;
            }
          }
        }
      }
    }
  }
}


