// =====================================================
// SOFTWARE I2C CLASS
// =====================================================

class SoftwareI2C {

  private:

    int SDA_PIN;
    int SCL_PIN;

    void sdaHigh() {
      pinMode(SDA_PIN, INPUT_PULLUP);
    }

    void sdaLow() {
      pinMode(SDA_PIN, OUTPUT);
      digitalWrite(SDA_PIN, LOW);
    }

    void sclHigh() {
      pinMode(SCL_PIN, INPUT_PULLUP);
    }

    void sclLow() {
      pinMode(SCL_PIN, OUTPUT);
      digitalWrite(SCL_PIN, LOW);
    }

    void delayI2C() {
      delayMicroseconds(10);
    }

  public:

    SoftwareI2C(int sda, int scl) {

      SDA_PIN = sda;
      SCL_PIN = scl;

      pinMode(SDA_PIN, INPUT_PULLUP);
      pinMode(SCL_PIN, INPUT_PULLUP);
    }


    void begin() {

      sdaHigh();
      sclHigh();

      delay(10);
    }


    void start() {

      sdaHigh();
      sclHigh();
      delayI2C();

      sdaLow();
      delayI2C();

      sclLow();
    }


    void stop() {

      sdaLow();
      delayI2C();

      sclHigh();
      delayI2C();

      sdaHigh();
      delayI2C();
    }


    bool writeByte(uint8_t data) {

      for (int i = 0; i < 8; i++) {

        if (data & 0x80) {
          sdaHigh();
        } else {
          sdaLow();
        }

        sclHigh();
        delayI2C();

        sclLow();
        delayI2C();

        data <<= 1;
      }

      // ACK

      sdaHigh();

      sclHigh();
      delayI2C();

      bool ack = (digitalRead(SDA_PIN) == LOW);

      sclLow();
      delayI2C();

      return ack;
    }


    void command(uint8_t cmd) {

      start();

      writeByte((OLED_ADDRESS << 1) | 0);

      writeByte(0x00);

      writeByte(cmd);

      stop();
    }


    void initOLED() {

      begin();

      command(0xAE); // Display OFF

      command(0xD5);
      command(0x80);

      command(0xA8);
      command(0x3F);

      command(0xD3);
      command(0x00);

      command(0x40);

      command(0x8D);
      command(0x14);

      command(0x20);
      command(0x00);

      command(0xA1);

      command(0xC8);

      command(0xDA);
      command(0x12);

      command(0x81);
      command(0xCF);

      command(0xD9);
      command(0xF1);

      command(0xDB);
      command(0x40);

      command(0xA4);

      command(0xA6);

      command(0xAF); // Display ON
    }


    void displayBitmap(const uint8_t *bitmap) {

      uint8_t pageBuffer[128];

      for (int page = 0; page < 8; page++) {

        for (int x = 0; x < 128; x++) {

          uint8_t value = 0;

          for (int bit = 0; bit < 8; bit++) {

            int y = page * 8 + bit;

            int byteIndex = (y * 16) + (x / 8);

            uint8_t sourceByte =
              pgm_read_byte(&bitmap[byteIndex]);

            uint8_t mask =
              0x80 >> (x & 7);

            if (sourceByte & mask) {
              value |= (1 << bit);
            }
          }

          pageBuffer[x] = value;
        }


        command(0xB0 + page);

        command(0x00);

        command(0x10);


        start();

        writeByte((OLED_ADDRESS << 1) | 0);

        writeByte(0x40);


        for (int x = 0; x < 128; x++) {
          writeByte(pageBuffer[x]);
        }

        stop();
      }
    }
};


